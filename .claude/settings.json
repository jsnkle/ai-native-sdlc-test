{
  "extraKnownMarketplaces": {
    "jsnkle": {
      "source": {
        "source": "github",
        "repo": "jsnkle/ai-native-sdlc"
      }
    }
  },
  "enabledPlugins": {
    "ai-native-sdlc@jsnkle": true
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)"
    ],
    "deny": [
      "Read(.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/production-gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protected-paths.sh"
          }
        ]
      }
    ]
  }
}
